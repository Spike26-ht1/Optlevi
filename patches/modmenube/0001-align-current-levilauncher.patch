diff --git a/android/src/LauncherHud.cpp b/android/src/LauncherHud.cpp
index f96224d..e64bacd 100644
--- a/android/src/LauncherHud.cpp
+++ b/android/src/LauncherHud.cpp
@@ -19,6 +19,22 @@ bool       gWeHid = false; // only undo what we did: the player may have hidden
 bool       gUnavailable = false;
 } // namespace
 
+void openModMenu() {
+    JNIEnv* e = jni::env();
+    if (!e) return;
+    e->PushLocalFrame(8);
+    jclass cls = jni::appClass(e, kManager);
+    jmethodID get = cls ? e->GetStaticMethodID(
+        cls, "getInstance",
+        "()Lorg/levimc/launcher/core/mods/inbuilt/overlay/InbuiltOverlayManager;") : nullptr;
+    jobject mgr = get ? e->CallStaticObjectMethod(cls, get) : nullptr;
+    jmethodID show = cls ? e->GetMethodID(cls, "showModMenu", "()V") : nullptr;
+    if (mgr && show) e->CallVoidMethod(mgr, show);
+    if (auto ex = jni::takeException(e); !ex.empty())
+        log().warn("could not open LeviLauncher Mod Menu: {}", ex);
+    e->PopLocalFrame(nullptr);
+}
+
 void setHudHidden(bool hidden) {
