{
  "namespace": "pause",
  "optlevi_pause_mods_button@common_buttons.light_text_button": {
    "size": [
      22,
      24
    ],
    "$button_text": "optlevi.menu.short_button",
    "$pressed_button_name": "button.optlevi_open_pause_menu",
    "$pressed_alpha": 0.55,
    "focus_identifier": "optlevi_pause_mods",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ]
  },
  "optlevi_pause_mods_panel": {
    "type": "input_panel",
    "size": [
      50,
      26
    ],
    "controls": [
      {
        "mods_button@pause.optlevi_pause_mods_button": {}
      },
      {
        "shaders_button@pause.optlevi_pause_shaders_button": {
          "offset": [
            25,
            0
          ]
        }
      }
    ]
  },
  "smaller_buttons_panel/stacked_column": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_after",
        "control_name": "small_achievements_button",
        "value": {
          "optlevi_mods@pause.optlevi_pause_mods_panel": {}
        }
      }
    ]
  },
  "optlevi_shaders_button@pause.pause_button_template": {
    "$button_text": "optlevi.shaders.button",
    "$pressed_button_name": "button.optlevi_shaders_placeholder",
    "$pressed_alpha": 0.55
  },
  "store_button_panel": {
    "type": "panel",
    "size": [
      "100%",
      28
    ],
    "controls": [
      {
        "shaders_button@pause.optlevi_shaders_button": {}
      }
    ]
  },
  "optlevi_shaders_small@common_buttons.light_text_button": {
    "size": [
      64,
      24
    ],
    "$button_text": "optlevi.shaders.button",
    "$pressed_button_name": "button.optlevi_shaders_placeholder",
    "$pressed_alpha": 0.55
  },
  "store_button_small_with_tooltip": {
    "type": "panel",
    "size": [
      64,
      24
    ],
    "controls": [
      {
        "shaders_button@pause.optlevi_shaders_small": {}
      }
    ]
  },
  "optlevi_pause_shaders_button@common_buttons.light_text_button": {
    "size": [
      22,
      24
    ],
    "$button_text": "optlevi.shaders.short_button",
    "$pressed_button_name": "button.optlevi_shaders_pause",
    "$pressed_alpha": 0.55,
    "focus_identifier": "optlevi_pause_shaders",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ]
  }
}
